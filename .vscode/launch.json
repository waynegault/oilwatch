{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OilWatch: status",
      "type": "debugpy",
      "request": "launch",
      "module": "oilwatch.cli",
      "args": ["status"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "OilWatch: quote-all",
      "type": "debugpy",
      "request": "launch",
      "module": "oilwatch.cli",
      "args": ["quote-all"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "OilWatch: run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-t", ".", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
