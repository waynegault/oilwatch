# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Database files
*.sqlite
*.sqlite3

# Everything under data/ is a local artifact: the live database, the generated
# explorer pages and charts, discovery output, registration results, and whatever
# a command's stdout gets redirected into. Ignored as a *directory* rather than
# file by file, because naming the files is how `data/ow-status.json` came to be
# committed on 2026-09-24 — a status dump carrying the owner's postcode, his
# purchase and the discount code he used, which is exactly the data the live
# database is kept out of git for.
data/*

# ...except the sanitised price-history snapshot, which is committed on purpose.
# It is built from the live database by tools/build_snapshot.py with those values
# withheld, so the price history is versioned. Rebuild it with that tool rather
# than by copying the live file. (This has to come *after* `data/*`: the last
# matching pattern wins.)
!data/oilwatch-history.sqlite

# Logs (generated; the scheduler and the scheduled email sweep write here)
*.log

# Chart images (generated)
*.png

# IDE
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/

# Credentials and personal config
config/supplier_credentials.json*
config/email_credentials.json
config/contact.json
config/settings.json

# Test coverage
htmlcov/
.coverage
.coverage.*

# graphify code graph (generated locally; the persistent graph lives in ~/.graphify)
graphify-out/

# Qwen Code local state (scratch, caches)
.qwen/

# Distribution
dist/
build/
*.egg-info/

