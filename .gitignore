# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Database files
*.sqlite
*.sqlite3

# ...except the sanitised price-history snapshot, which is committed on purpose.
# The live database holds the owner's correspondence, his mailbox's message ids
# and his postcode, so it stays local; this one is built from it by
# tools/build_snapshot.py with those withheld, and exists so the price history is
# versioned. Rebuild it with that tool rather than by copying the live file.
!data/oilwatch-history.sqlite

# Logs (generated; the scheduler and the scheduled email sweep write here)
*.log

# Chart images (generated)
*.png

# IDE
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/

# Credentials and personal config
config/supplier_credentials.json*
config/email_credentials.json
config/contact.json
config/settings.json

# API discovery results (large files)
data/api_discovery/

# Generated data explorer pages: a snapshot of the live database, rebuilt on
# demand, so they are not committed (see *.png above for the same reasoning).
data/*.html

# Registration results
data/registration_results.json

# Test coverage
htmlcov/
.coverage
.coverage.*

# graphify code graph (generated locally; the persistent graph lives in ~/.graphify)
graphify-out/

# Qwen Code local state (scratch, caches)
.qwen/

# Distribution
dist/
build/
*.egg-info/

